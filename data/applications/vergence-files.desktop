[Desktop Entry]
Type=Application
Name=File Viewer
GenericName=File Manager
Comment=Your folders and files, with Preview on the space bar
Exec=vergence-files %U
Icon=vergence-files
Terminal=false
Categories=System;FileManager;Utility;
