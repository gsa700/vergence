#!/bin/sh
# The Vergence session: vergence-server on the real monitors. Started by a display
# manager ("Vergence" at the login screen; share/wayland-sessions/vergence.desktop)
# or by hand from a text console (`vergence`, a link to this script). Seat and
# devices through libseat: logind where it runs (Fedora), seatd everywhere else
# (FreeBSD, Linux without systemd). `vctl restart` (exit status 75) starts the
# server again with the binary that is there now; any other exit ends the session.
#
# Runs installed (tools/install.sh puts it in one bin directory with the server)
# or from a checkout (this script in tools/, the binaries in ../target/release).
# A checkout is a development session: the control socket (vctl) is on. An
# installed session has it off (security pass 2026-11-08) unless VERGENCE_CONTROL=1
# is in the environment or the user has created ~/.config/vergence/control-socket.
# `vergence --clean` starts without bringing back the applications the last
# session had running (session restore; a restart within the session restores).
clean=
[ "$1" = "--clean" ] && clean=1
here=$(dirname "$(realpath "$0")")
installed=
if [ -n "$VERGENCE_SERVER" ]; then
    BIN=$VERGENCE_SERVER
elif [ -x "$here/vergence-server" ]; then
    BIN=$here/vergence-server                        # installed: beside this script
    installed=1
elif [ -x "$here/../target/release/vergence-server" ]; then
    BIN=$here/../target/release/vergence-server     # a checkout
    # Its programs first on PATH, so the shelf's desktop entries
    # (Exec=vergence-term) and `vergence-term -e` find this build's.
    PATH=$(cd "$here/../target/release" && pwd):$PATH
    export PATH
else
    BIN=vergence-server                              # whatever PATH finds
    installed=1
fi
# A display manager's PAM gives a private runtime directory; from a console there
# is none (nor on a Linux without logind): make one.
if [ -z "$XDG_RUNTIME_DIR" ]; then
    XDG_RUNTIME_DIR=/tmp/xdg-$(id -u)
    mkdir -p "$XDG_RUNTIME_DIR" && chmod 700 "$XDG_RUNTIME_DIR"
fi
export XDG_RUNTIME_DIR
# The server tells apps their scale (Wayland fractional scale; XSETTINGS and
# Xft.dpi for X apps). Factors meant for an X11 desktop must not reach them: the
# display manager's wrapper sources ~/.xprofile, where vergd (phase 1) loads its
# per-monitor session.env for Xorg.
unset QT_SCREEN_SCALE_FACTORS QT_SCALE_FACTOR QT_AUTO_SCREEN_SCALE_FACTOR \
    AVALONIA_SCREEN_SCALE_FACTORS AVALONIA_GLOBAL_SCALE_FACTOR \
    GDK_SCALE GDK_DPI_SCALE _JAVA_OPTIONS VERGENCE_SCALE DISPLAY
# Seat and device access: libseat finds logind by itself where systemd runs
# (Fedora on Techbench, 2026-11-08); everywhere else it is seatd.
if [ -z "$LIBSEAT_BACKEND" ] && [ ! -d /run/systemd/system ]; then
    export LIBSEAT_BACKEND=seatd
fi
export XDG_SESSION_TYPE=wayland XDG_CURRENT_DESKTOP=Vergence
# The system's locale when nothing set one (started over ssh, or by a launcher
# that skipped the login shell): without it programs see POSIX and some
# refuse to run (btop: "No UTF-8 locale detected", 2026-11-11). Linux keeps
# it in /etc/locale.conf; FreeBSD's login.conf class sets it at login.
if [ -z "${LANG:-}" ] && [ -r /etc/locale.conf ]; then
    while IFS='=' read -r key value; do
        case $key in LANG|LC_[A-Z]*) export "$key=$(printf %s "$value" | tr -d '"')" ;; esac
    done < /etc/locale.conf
fi
# GTK programs (Firefox among them) read the desktop's settings from the
# settings portal only when told to; the server's D-Bus edge is that portal,
# and so they get our window buttons' layout, theme and fonts. What else
# they ask a portal for (a file dialog) we answer "unknown", and they use
# their own (seen with Firefox on kepler, 2026-11-10).
export GTK_USE_PORTAL=${GTK_USE_PORTAL:-1}
# The development control socket (vctl; src/control.rs): any program running as
# the user can drive the session through it, so this is what makes a session a
# development session. On from a checkout; off when installed, unless asked.
if [ -z "$VERGENCE_CONTROL" ]; then
    if [ -z "$installed" ] || [ -f "${XDG_CONFIG_HOME:-$HOME/.config}/vergence/control-socket" ]; then
        VERGENCE_CONTROL=1
    fi
fi
[ -n "$VERGENCE_CONTROL" ] && export VERGENCE_CONTROL
export RUST_LOG=${RUST_LOG:-info,smithay=warn}
# The log: ~/.local/state/vergence/server.log (owner-only: window titles are in it),
# beside vergd's; the previous run's is kept as server.log.1 (a `vctl restart`
# after a GPU hang used to wipe the evidence, 2026-11-08).
STATE=${XDG_STATE_HOME:-$HOME/.local/state}/vergence
mkdir -p "$STATE" && chmod 700 "$STATE"
LOG=$STATE/server.log
# A quick failure at start is retried: when the user logs out of an X session and
# into this one, the display manager starts us while the old X server is still
# letting go of the display ("Failed to disable connectors: Permission denied",
# Hubble 2026-11-07). Each try's log is kept beside the main one.
tries=0
while :; do
    started=$(date +%s)
    [ -s "$LOG" ] && mv "$LOG" "$LOG.1"
    VERGENCE_CLEAN=$clean "$BIN" --drm > "$LOG" 2>&1
    status=$?
    clean=
    if [ "$status" -eq 75 ]; then
        tries=0
        sleep 1
        continue
    fi
    if [ "$status" -ne 0 ] && [ $(( $(date +%s) - started )) -lt 5 ] && [ "$tries" -lt 5 ]; then
        tries=$((tries + 1))
        cp "$LOG" "$LOG.try$tries"
        sleep 1
        continue
    fi
    break
done
exit "$status"
