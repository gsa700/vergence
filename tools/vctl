#!/bin/sh
# Talk to a running vergence-server's control socket (src/control.rs):
#   vctl shot | windows | spawn <command> | move <i> <x> <y> | focus <i> | restart | quit
# Same user only (the socket is 0600 and checks the peer's uid).
# The server's runtime directory: this shell's, lightdm's (pam_xdg), or the console
# launcher's.
sock=
for d in "$XDG_RUNTIME_DIR" "/var/run/xdg/$(id -un)" "/tmp/xdg-$(id -u)"; do
    [ -n "$d" ] && [ -S "$d/vergence-control" ] && { sock=$d/vergence-control; break; }
done
[ -n "$sock" ] || { echo "no vergence-server control socket found" >&2; exit 1; }
printf '%s\n' "$*" | nc -U -N "$sock"
