#!/bin/sh
# Talk to a running vergence-server's control socket (src/control.rs):
#   vctl shot | windows | gpus | tree | spawn <command> | move <i> <x> <y> (remembered, as a move by hand) | focus <i> | restart | quit
# Same user only (the socket is 0600 and checks the peer's uid), and only when
# the server was started with VERGENCE_CONTROL=1 (the launchers in tools/ do).
# The server's runtime directory: this shell's, logind's (Linux), lightdm's
# (pam_xdg), or the console launcher's.
# VCTL_SOCKET names one socket and nothing else is tried: a script driving a
# nested server must never fall through to the session it runs in (a test
# quit Hubble's session that way, 2026-11-12).
sock=
if [ -n "$VCTL_SOCKET" ]; then
    [ -S "$VCTL_SOCKET" ] || { echo "no vergence-server control socket at $VCTL_SOCKET" >&2; exit 1; }
    sock=$VCTL_SOCKET
fi
[ -n "$sock" ] || for d in "$XDG_RUNTIME_DIR" "/run/user/$(id -u)" "/var/run/xdg/$(id -un)" "/tmp/xdg-$(id -u)"; do
    [ -n "$d" ] && [ -S "$d/vergence-control" ] && { sock=$d/vergence-control; break; }
done
[ -n "$sock" ] || { echo "no vergence-server control socket found" >&2; exit 1; }
# BSD netcat needs -N to send EOF after the command; Fedora's nc is Nmap's
# ncat, which has no -N and does that by itself (the server closes after replying).
if nc -h 2>&1 | grep -q -- '^[[:space:]]*-N'; then
    printf '%s\n' "$*" | nc -U -N "$sock"
else
    printf '%s\n' "$*" | nc -U "$sock"
fi
