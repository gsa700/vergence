#!/bin/sh
# vergence-setup: the system setup Vergence needs, done once as root after
# installing it (packaging milestone 1, 2026-11-22). A package enables nothing
# by itself (Void's way); this says what each step changes and asks first.
# tools/install.sh runs it too (--yes), so there is one copy of these steps.
#
#   sudo vergence-setup [--yes] [--user NAME] [--login-screen on|off]
#   sudo vergence-setup --undo      before removing Vergence (below)
#
#   --yes            do every step without asking (install.sh, scripts)
#   --user NAME      the person who uses Vergence (default: who ran sudo/doas)
#   --login-screen   on: start the machine at the Vergence login screen;
#                    off: at a text console. Without it: asked (left as is
#                    with --yes).
#
# Steps, each skipped when already so: the seat (seatd, and its group for the
# person and the login screen's account), the vdm service, the login screen at
# boot, the system bus and polkitd for drives (where udisks2 is installed),
# wpa_supplicant (where there is a Wi-Fi card), acpid leaving the power key to
# a running session, a system log for vdm, ALSA programs routed through
# PipeWire (Linux, where alsa-pipewire is installed: the session starts
# PipeWire), the person's shell (a ~/.zshrc loading Vergence's zsh setup when
# they have none; zsh as their login shell, asked, never with --yes). Then
# hints for what it cannot do (packages to install). Linux with runit (Void)
# or systemd, and FreeBSD.
#
# --undo, before `xbps-remove vergence`: vdm disabled (the login screen ends,
# and with it every Vergence session), automatic login and the login screen
# at boot turned off (a later install brings neither back silently), acpid's
# handler as it was, the ALSA routing links it made removed. Accounts, groups
# and the other services are left.
set -u
# Root's own PATH, not the one sudo or doas may pass on (packaging review).
PATH=/usr/bin:/usr/sbin:/bin:/sbin:/usr/local/bin:/usr/local/sbin
export PATH
undo=
yes=
user=${SUDO_USER:-${DOAS_USER:-}}
login_screen=
need() { [ $# -ge 2 ] || { echo "vergence-setup: $1 needs a value (--help)" >&2; exit 2; }; }
while [ $# -gt 0 ]; do
    case $1 in
        --yes|-y) yes=1; shift ;;
        --undo) undo=1; shift ;;
        --user) need "$@"; user=$2; shift 2 ;;
        --login-screen) need "$@"; login_screen=$2; shift 2 ;;
        -h|--help) sed -n '2,29p' "$0"; exit 0 ;;
        *) echo "vergence-setup: unknown option $1 (--help)" >&2; exit 2 ;;
    esac
done
[ "$(id -u)" = 0 ] || { echo "vergence-setup: run it as root (sudo vergence-setup)" >&2; exit 1; }
case $login_screen in ''|on|off) ;; *) echo "vergence-setup: --login-screen on or off" >&2; exit 2 ;; esac
[ -z "$user" ] || id -- "$user" >/dev/null 2>&1 || { echo "vergence-setup: no account $user" >&2; exit 1; }

os=$(uname -s)
runit=
[ "$os" = Linux ] && [ -d /etc/sv ] && [ -d /var/service ] && runit=1
systemd=
[ -d /run/systemd/system ] && systemd=1
if [ "$os" = FreeBSD ]; then state=/var/db/vdm; else state=/var/lib/vdm; fi

# Ask before a change: what it does, yes or no (yes with --yes; no without a
# terminal to ask at).
ask() {
    [ -n "$yes" ] && return 0
    [ -t 0 ] || { echo "  skipped (no terminal to ask at; --yes does it): $1"; return 1; }
    printf '%s [y/N] ' "$1"
    read -r a
    case $a in y|Y|yes|Yes) return 0 ;; *) return 1 ;; esac
}
in_group() { id -Gn -- "$1" 2>/dev/null | tr ' ' '\n' | grep -qx "$2"; }
add_to_group() {
    if [ "$os" = FreeBSD ]; then pw groupmod "$2" -m "$1"; else usermod -aG "$2" "$1"; fi
}
# A runit service enabled (linked into /var/service), if it exists and is not.
runit_enable() {
    [ -d "/etc/sv/$1" ] || { echo "  no /etc/sv/$1 (its package is not installed)" >&2; return 1; }
    [ -e "/var/service/$1" ] && return 0
    ln -s "/etc/sv/$1" "/var/service/$1"
}

# ---- --undo: before removing Vergence ----
if [ -n "$undo" ]; then
    if [ -n "$runit" ] && [ -L /var/service/vdm ]; then
        ask "vdm: disable it? The login screen and every Vergence session end now." \
            && rm -f /var/service/vdm && echo "vdm: disabled (/var/service/vdm removed)"
    elif [ -n "$systemd" ] && systemctl is-enabled vdm >/dev/null 2>&1; then
        ask "vdm: disable and stop it? Every Vergence session ends now." \
            && systemctl disable --now vdm >/dev/null 2>&1 && echo "vdm: disabled"
    elif [ "$os" = FreeBSD ] && [ "$(sysrc -n vdm_enable 2>/dev/null)" = YES ]; then
        ask "vdm: disable it (rc.conf)? It stops at the next boot." \
            && sysrc vdm_enable=NO >/dev/null && echo "vdm: disabled"
    fi
    for f in autologin login-screen; do
        [ -e "$state/$f" ] && rm -f "$state/$f" && echo "vdm: $f turned off"
    done
    handler=/etc/acpi/handler.sh
    if [ -f "$handler.vergence-orig" ] && grep -q 'vdm/power-key' "$handler" 2>/dev/null; then
        mv -f "$handler.vergence-orig" "$handler" && echo "power key: acpid's handler as it was"
    fi
    # Only the links this made (listed when made); links the person made stay.
    if [ -f "$state/alsa-links" ]; then
        while IFS= read -r link; do
            [ -L "$link" ] && rm -f "$link" && echo "sound: $link removed"
        done < "$state/alsa-links"
        rm -f "$state/alsa-links"
    fi
    echo "undone: now sudo xbps-remove vergence (accounts, groups and other services are left as they are)"
    exit 0
fi

# ---- the seat ----
group=
if [ -n "$runit" ] && [ -e /var/service/elogind ]; then
    echo "seat: elogind is enabled here; Vergence uses seatd (elogind may stay for other programs, or be disabled)"
fi
if [ -n "$systemd" ]; then
    echo "seat: logind (systemd) manages the seat; nothing to do"
elif [ "$os" = FreeBSD ]; then
    group=video
    if [ "$(sysrc -n seatd_enable 2>/dev/null)" = YES ]; then
        echo "seat: seatd is enabled"
    elif command -v seatd >/dev/null 2>&1; then
        ask "seat: enable and start seatd (Vergence takes the screens and input through it)?" \
            && sysrc seatd_enable=YES >/dev/null && { service seatd start >/dev/null 2>&1 || true; } && echo "seat: seatd enabled and started"
    else
        echo "seat: seatd is not installed (pkg install seatd)" >&2
    fi
elif [ -n "$runit" ] && [ -d /etc/sv/seatd ]; then
    group=_seatd
    if [ -e /var/service/seatd ]; then
        echo "seat: seatd is enabled"
    else
        ask "seat: enable seatd (runit; Vergence takes the screens and input through it)?" \
            && runit_enable seatd && echo "seat: seatd enabled (/var/service/seatd)"
    fi
else
    echo "seat: no logind and no seatd service found; install and enable seatd" >&2
fi
if [ -n "$group" ]; then
    for who in ${user:+"$user"} _vdm; do
        id "$who" >/dev/null 2>&1 || continue
        if in_group "$who" "$group"; then
            echo "seat: $who is in $group"
        elif ask "seat: add $who to $group (may use the screens and input)?"; then
            add_to_group "$who" "$group" && echo "seat: $who added to $group (from their next login)"
        fi
    done
    [ -n "$user" ] || echo "seat: add each person who uses Vergence to $group (--user NAME does it)"
fi

# ---- the login screen at boot ----
# Before vdm is enabled (packaging review, L2): a vdm started just after reads it.
mkdir -p "$state" && chmod 700 "$state" || echo "login screen: cannot make $state" >&2
if [ -z "$login_screen" ] && [ -z "$yes" ] && [ ! -f "$state/login-screen" ]; then
    ask "login screen: start this machine at the Vergence login screen (the text consoles stay, Ctrl+Alt+F1)?" && login_screen=on
fi
case $login_screen in
    on) : > "$state/login-screen" && echo "login screen: on (when vdm starts, at boot or now if it is just being enabled)" ;;
    off) rm -f "$state/login-screen" && echo "login screen: off; log in on a text console and run vergence" ;;
    *) [ -f "$state/login-screen" ] && echo "login screen: on at boot" ;;
esac

# ---- vdm, the login screen's service ----
if [ -n "$runit" ]; then
    if [ ! -d /etc/sv/vdm ]; then
        echo "vdm: no /etc/sv/vdm (the package or tools/install.sh writes it)" >&2
    elif [ -e /var/service/vdm ]; then
        echo "vdm: enabled (runit)"
    elif ask "vdm: enable vdm (runit; it runs the login screen and the lock screen's password checks)?"; then
        runit_enable vdm && echo "vdm: enabled and started (/var/service/vdm)"
    fi
elif [ -n "$systemd" ]; then
    if systemctl is-enabled vdm >/dev/null 2>&1; then
        echo "vdm: enabled (systemd)"
    elif ask "vdm: enable and start vdm (systemd)?"; then
        systemctl enable --now vdm >/dev/null 2>&1 && echo "vdm: enabled and started (systemd)"
    fi
elif [ "$os" = FreeBSD ]; then
    if [ "$(sysrc -n vdm_enable 2>/dev/null)" = YES ]; then
        echo "vdm: enabled (rc.conf)"
    elif ask "vdm: enable and start vdm (rc.conf)?"; then
        sysrc vdm_enable=YES >/dev/null && { service vdm start >/dev/null 2>&1 || true; } && echo "vdm: enabled and started"
    fi
fi

# ---- removable drives (Linux; FreeBSD's automounter is install.sh's) ----
if [ "$os" = Linux ]; then
    if command -v udisksctl >/dev/null 2>&1 || [ -x /usr/libexec/udisks2/udisksd ] || [ -x /usr/lib/udisks2/udisksd ]; then
        if [ -n "$runit" ]; then
            # udisks2 is reached on the system bus, which a base Void does not
            # run; without logind, polkitd answers for the seat group's rule.
            for s in dbus polkitd; do
                [ -d "/etc/sv/$s" ] || continue
                if [ -e "/var/service/$s" ]; then
                    echo "drives: $s is enabled"
                elif ask "drives: enable $s (runit; drives plugged in are mounted through udisks2 on it)?"; then
                    runit_enable "$s" && echo "drives: $s enabled"
                fi
            done
        else
            echo "drives: udisks2 is installed; the session mounts drives through it"
        fi
    else
        echo "drives: udisks2 is not installed, so drives plugged in are not mounted (Void: xbps-install udisks2 dbus)" >&2
    fi
fi

# ---- Wi-Fi (Linux with runit; FreeBSD's is install.sh's) ----
if [ -n "$runit" ] && [ ! -d /run/NetworkManager ]; then
    cards=
    for d in /sys/class/net/*; do
        [ -d "$d/wireless" ] || [ -e "$d/phy80211" ] || continue
        cards="$cards ${d##*/}"
    done
    if [ -z "$cards" ]; then
        echo "wifi: no Wi-Fi card; nothing to do"
    elif [ -e /var/service/wpa_supplicant ]; then
        echo "wifi: wpa_supplicant is enabled"
    elif [ -d /etc/sv/wpa_supplicant ] && ask "wifi: enable wpa_supplicant for$cards (its control socket for the wheel group, so Settings can join networks)?"; then
        conf=/etc/wpa_supplicant/wpa_supplicant.conf
        [ -e "$conf" ] || { mkdir -p /etc/wpa_supplicant; : > "$conf"; chmod 600 "$conf"; }
        grep -q '^ctrl_interface=' "$conf" || echo 'ctrl_interface=/run/wpa_supplicant' >> "$conf"
        grep -q '^ctrl_interface_group=' "$conf" || echo 'ctrl_interface_group=wheel' >> "$conf"
        grep -q '^update_config=' "$conf" || echo 'update_config=1' >> "$conf"
        runit_enable wpa_supplicant && echo "wifi: wpa_supplicant enabled"
    fi
    if [ -n "$cards" ] && [ -n "$user" ] && ! in_group "$user" wheel; then
        echo "wifi: $user is not in wheel, so Settings cannot use Wi-Fi (add them to wheel to allow it)"
    fi
fi

# ---- the power key (acpid, Linux without logind) ----
# While a session runs, vdm holds the power key so it opens the session
# dialog; acpid's handler shuts down whatever runs, so it is taught to leave
# the key alone while vdm's flag is there (the original kept beside it).
handler=/etc/acpi/handler.sh
if [ -f "$handler" ] && ! grep -q 'vdm/power-key' "$handler"; then
    if ! grep -q 'PowerButton pressed' "$handler"; then
        echo "power key: $handler not as expected; acpid still shuts down on it" >&2
    elif ask "power key: let a running session have it (a line added to $handler; the original kept)?"; then
        [ -f "$handler.vergence-orig" ] || cp -p "$handler" "$handler.vergence-orig"
        sed -i '/logger "PowerButton pressed/i\                [ -e /run/vdm/power-key ] \&\& { logger "PowerButton: the Vergence session asks"; exit 0; }' "$handler"
        echo "power key: acpid leaves it to a running session (the original is $handler.vergence-orig)"
    fi
fi

# ---- a system log for vdm (Void runs none by itself) ----
if [ -n "$runit" ] && ! ls /var/service | grep -q -E '^(socklog|syslog|rsyslog|metalog)'; then
    if [ -d /etc/sv/socklog-unix ]; then
        if ask "log: enable socklog (vdm's log, and the system's, kept in /var/log/socklog)?"; then
            runit_enable socklog-unix && echo "log: socklog-unix enabled"
            runit_enable nanoklogd && echo "log: nanoklogd enabled (the kernel's messages)"
        fi
    else
        echo "log: no system log runs, so vdm's log is lost (xbps-install socklog-void, then run this again)" >&2
    fi
fi

# ---- ALSA programs through PipeWire (Linux) ----
# The session starts PipeWire (vergence-server, soundserver.rs); programs that
# open ALSA's default device then play through it too instead of taking the
# card for themselves. alsa-pipewire ships the two files; Void's way is to link
# them into /etc/alsa/conf.d. The links made are listed for --undo.
alsa_share=/usr/share/alsa/alsa.conf.d
if [ "$os" = Linux ] && [ -f "$alsa_share/50-pipewire.conf" ] && [ -f "$alsa_share/99-pipewire-default.conf" ] \
    && { [ ! -e /etc/alsa/conf.d/50-pipewire.conf ] || [ ! -e /etc/alsa/conf.d/99-pipewire-default.conf ]; }; then
    if ask "sound: route ALSA programs through PipeWire (links in /etc/alsa/conf.d)?"; then
        mkdir -p /etc/alsa/conf.d "$state"
        for f in 50-pipewire.conf 99-pipewire-default.conf; do
            if [ ! -e "/etc/alsa/conf.d/$f" ]; then
                ln -s "$alsa_share/$f" "/etc/alsa/conf.d/$f" && echo "/etc/alsa/conf.d/$f" >> "$state/alsa-links" \
                    && echo "sound: /etc/alsa/conf.d/$f linked"
            fi
        done
    fi
elif [ "$os" = Linux ] && command -v pipewire >/dev/null 2>&1 && [ ! -f "$alsa_share/50-pipewire.conf" ]; then
    echo "sound: ALSA programs will not go through PipeWire (Void: xbps-install alsa-pipewire, then run this again)" >&2
fi

# ---- the person's shell: Vergence's zsh setup ----
# A ~/.zshrc of one line loading share/vergence/zshrc (data/shell/zshrc), only
# for a person who has none: theirs from then on, never written again; an
# existing one is left as it is, with the line to add. Made with noclobber
# (O_EXCL), so nothing at that path, a link included, is ever written through.
# Their login shell becomes zsh only on a yes asked here, never with --yes
# (Dave, 2026-11-27).
zshrc=$(cd "$(dirname "$0")/.." 2>/dev/null && pwd)/share/vergence/zshrc
if [ -n "$user" ] && [ -f "$zshrc" ]; then
    entry=$(getent passwd "$user")
    home=$(echo "$entry" | cut -d: -f6)
    shell=$(echo "$entry" | cut -d: -f7)
    if [ -z "$home" ] || [ ! -d "$home" ]; then
        echo "shell: $user has no home folder; no ~/.zshrc written" >&2
    elif [ -e "$home/.zshrc" ] || [ -L "$home/.zshrc" ]; then
        grep -qF "$zshrc" "$home/.zshrc" 2>/dev/null \
            || echo "shell: $home/.zshrc is $user's own and stays as it is; for Vergence's zsh setup, put this line at its top: source $zshrc"
    elif ask "shell: write $home/.zshrc for $user (one line loading Vergence's zsh setup; theirs to change)?"; then
        if ( set -C; umask 022; printf '%s\n' \
            "# Vergence's zsh setup. Your choices go in ~/.config/vergence/shell.conf (Settings > Shell);" \
            "# this file is yours: add your own lines below." \
            "source $zshrc" > "$home/.zshrc" ) 2>/dev/null; then
            chown -h "$user:$(id -gn -- "$user")" "$home/.zshrc" && echo "shell: $home/.zshrc written"
        else
            echo "shell: could not write $home/.zshrc" >&2
        fi
    fi
    zsh=$(command -v zsh)
    if [ -z "$zsh" ]; then
        echo "shell: zsh is not installed (Void: xbps-install zsh; FreeBSD: pkg install zsh)" >&2
    elif [ "$(basename "$shell")" != zsh ]; then
        if [ -n "$yes" ]; then
            echo "shell: $user's login shell stays $shell (vergence-setup without --yes asks to make it zsh)"
        elif ask "shell: make zsh the login shell for $user (now $shell)?"; then
            chsh -s "$zsh" "$user" && echo "shell: $user's login shell is now $zsh (from their next login)"
        fi
    fi
fi

# ---- what it cannot do: hints ----
if [ "$os" = Linux ]; then
    distro=$(. /etc/os-release 2>/dev/null; echo "${ID:-}")
    for dev in /sys/class/drm/card[0-9]*/device; do
        [ -e "$dev/driver" ] || continue
        [ "$(basename "$(readlink "$dev/driver")")" = nouveau ] || continue
        icd=; lib=
        for f in /usr/share/vulkan/icd.d/nouveau_icd*.json; do [ -e "$f" ] && icd=1; done
        for f in /usr/lib/libvulkan.so.1 /usr/lib64/libvulkan.so.1 /usr/lib/*/libvulkan.so.1; do [ -e "$f" ] && lib=1; done
        if [ -z "$icd" ] || [ -z "$lib" ]; then
            case "$distro" in
                void) pkgs="mesa-vulkan-nouveau vulkan-loader (xbps-install)" ;;
                fedora) pkgs="mesa-vulkan-drivers vulkan-loader (dnf install)" ;;
                *) pkgs="Mesa's NVK Vulkan driver and the Vulkan loader" ;;
            esac
            echo "gpu: NVIDIA (nouveau) has no OpenGL of its own: screens on it would be drawn by the CPU. Install $pkgs" >&2
        fi
    done
fi
command -v nc >/dev/null 2>&1 || echo "vctl: needs nc (Void: xbps-install openbsd-netcat)" >&2
if [ -f "$state/login-screen" ]; then
    echo "start: choose Vergence at the login screen, or 'vergence' from a text console"
else
    echo "start: 'vergence' from a text console (vergence-setup --login-screen on starts the machine at the login screen)"
fi
