+/**
+ * webkit_web_view_set_obscured_content_insets:
+ * @web_view: a #WebKitWebView
+ *
+ * Vergence spike: the view's edges covered by the program's own bars, in
+ * points; the page lays out and scrolls as if its edges started inside them.
+ */
+void webkit_web_view_set_obscured_content_insets(WebKitWebView* webView, double top, double right, double bottom, double left)
+{
+    g_return_if_fail(WEBKIT_IS_WEB_VIEW(webView));
+    getPage(webView).setObscuredContentInsets(WebCore::FloatBoxExtent(float(top), float(right), float(bottom), float(left)));
+}
