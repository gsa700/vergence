# Template file for 'vergence'
pkgname=vergence
version=0.4.0pre6
revision=1
# A lab build before the 0.4.0 release (Vergence Remote), from a commit:
# xbps orders 0.4.0pre1 after 0.3.0 and before 0.4.0. GitHub serves a
# commit's tarball as it serves a tag's.
_commit=8432dd486a9a790400f7f324d2410c3687a6d80e
build_style=cargo
hostmakedepends="pkg-config"
makedepends="libarchive-devel libinput-devel libxkbcommon-devel libseat-devel libgbm-devel
 libdrm-devel eudev-libudev-devel wayland-devel wayland-protocols
 fontconfig-devel pam-devel"
# The two font packages are for characters our own fonts lack: symbols
# programs print in a terminal (Claude Code's ✻ ⏵ ⎿) and other scripts.
# A base Void has no fonts at all (techbench, 2026-11-23).
depends="seatd mesa-dri fontconfig dbus udisks2 polkit openbsd-netcat
 pipewire wireplumber alsa-pipewire dejavu-fonts-ttf noto-fonts-ttf"
short_desc="Desktop with its own display server, toolkit and applications"
maintainer="David Erickson <gsa700@gmail.com>"
# The code is Apache-2.0 OR GPL-2.0-or-later; the AAC helper GPL-2.0-or-later
# alone (FAAD2's code); the fonts OFL-1.1; the spelling list SCOWL's own.
license="Apache-2.0 OR GPL-2.0-or-later, GPL-2.0-or-later, OFL-1.1, custom:SCOWL"
homepage="https://github.com/gsa700/vergence"
distfiles="https://github.com/gsa700/vergence/archive/${_commit}.tar.gz"
checksum=35deacaf8693fb44679d61c0e312d4659283e58b8ca9aa98ea17a906248d419f

# The login screen's account: owns nothing, logs in nowhere, may use the seat.
system_accounts="_vdm"
_vdm_homedir="/var/empty"
_vdm_descr="Vergence display manager (greeter)"
_vdm_groups="_seatd"

conf_files="/etc/pam.d/vdm /etc/pam.d/vdm-unlock /etc/pam.d/vdm-elevate
 /etc/pam.d/vdm-greeter /etc/pam.d/vdm-autologin /etc/zzz.d/suspend/50-vdm"
font_dirs="/usr/share/vergence/fonts"
# The icon and pointer themes are drawn at install time by the build's own
# vergence-harness, which a cross build cannot run (packaging review, M3).
nocross="vergence-harness draws the icon themes during do_install"

# The workspace's binaries, built by the cargo style; installed by the
# project's own tools/install.sh (staged, so it touches nothing outside
# DESTDIR), then the files a Void system needs. Nothing is enabled:
# vergence-setup does that, run once by the administrator (INSTALL says so).
do_install() {
	VERGENCE_RELEASE_DIR="target/${RUST_TARGET}/release" \
		./tools/install.sh --prefix /usr --destdir "${DESTDIR}" --no-lab
	# Void has no /usr/sbin of its own (a link to bin): vdm and
	# vergence-setup go in /usr/bin (vdm finds the server beside it).
	mv "${DESTDIR}"/usr/sbin/* "${DESTDIR}/usr/bin/"
	rmdir "${DESTDIR}/usr/sbin"

	for f in vdm vdm-unlock vdm-elevate vdm-greeter vdm-autologin; do
		vinstall "${FILESDIR}/pam.d/${f}" 644 etc/pam.d
	done
	vsv vdm
	vinstall "${FILESDIR}/50-vdm" 755 etc/zzz.d/suspend
	vinstall tools/linux/50-vergence-drives.rules 644 usr/share/polkit-1/rules.d
	vinstall "${FILESDIR}/90-vergence-fonts.conf" 644 usr/share/fontconfig/conf.avail
	vmkdir etc/fonts/conf.d
	ln -s /usr/share/fontconfig/conf.avail/90-vergence-fonts.conf \
		"${DESTDIR}/etc/fonts/conf.d/90-vergence-fonts.conf"
	vlicense LICENSE-APACHE
	vlicense data/fonts/Inter-OFL.txt
	vlicense data/fonts/JetBrainsMono-OFL.txt
	vlicense data/fonts/Liberation-OFL.txt
	vlicense data/words/SCOWL-COPYRIGHT.txt
}
